# Copy this file to `.env` and fill in real values for local testing.
# In production, set these via:  firebase functions:secrets:set SMTP_EMAIL
# and:                            firebase functions:secrets:set SMTP_PASSWORD

# The Outlook/Microsoft 365 mailbox that authenticates and SENDS notifications.
# info@alrayyanjo.com is a forwarding alias, not a real inbox, so it can't log
# in on its own — this must be a real mailbox (e.g. zaid@alrayyanjo.com) that
# has info@alrayyanjo.com added as a "Send As" alias, so outgoing mail can
# genuinely show From: info@alrayyanjo.com. See SETUP.md.
SMTP_EMAIL=zaid@alrayyanjo.com

# App Password for that Outlook account (NOT its normal login password) —
# generate at: https://account.microsoft.com/security → Advanced security
# options → App passwords. (Requires 2-Step Verification enabled.)
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Where admin notifications are SENT TO.
ADMIN_EMAIL=info@alrayyanjo.com

# Public site URL used in email links (admin panel link, etc).
SITE_URL=https://alrayyanjo.com
