# Copy this file to `.env` and fill in real values for local testing.
# In production, set these via:  firebase functions:secrets:set GMAIL_EMAIL
# and:                            firebase functions:secrets:set GMAIL_APP_PASSWORD

# The Gmail account that SENDS notifications (your business email).
GMAIL_EMAIL=omaralrayyan7@gmail.com

# App Password (16 characters, no spaces) — generate at:
# https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled on the account.)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where admin notifications are SENT TO (can be same as GMAIL_EMAIL).
ADMIN_EMAIL=alrayyantower@gmail.com

# Public site URL used in email links (admin panel link, etc).
SITE_URL=https://alrayyanjo.com
