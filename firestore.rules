rules_version = '2';

// ────────────────────────────────────────────────────────────────────────────
// Alrayyan Tower — Firestore Security Rules (Production)
//
// isAdmin() restricts ALL sensitive reads/writes to the specific admin
// account (info@alrayyanjo.com).  Public users can only CREATE
// documents in a handful of collections, and every public write is
// validated for field types and sizes to block spam/flooding.
// ────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'info@alrayyanjo.com';
    }

    function strOpt(field, maxLen) {
      return !(field in request.resource.data)
          || (request.resource.data[field] is string
              && request.resource.data[field].size() <= maxLen);
    }

    function validBooking() {
      let d = request.resource.data;
      return d.keys().size() <= 25
          // Public submissions are always 'pending' — only the admin can move a
          // booking to confirmed/rejected/rescheduled (which triggers customer email).
          && (!('status' in d) || d.status == 'pending')
          && d.visitor_name is string && d.visitor_name.size() >= 2  && d.visitor_name.size() <= 150
          && d.phone        is string && d.phone.size()        >= 5  && d.phone.size()        <= 30
          && strOpt('email',            150)
          && strOpt('company',          150)
          && strOpt('floor_preference', 120)
          && strOpt('preferred_date',    20)
          && strOpt('preferred_time',    20)
          && strOpt('purpose',          500)
          && strOpt('notes',           1000)
          && strOpt('source',            50)
          && strOpt('ref',               30);
    }

    function validVisitor() {
      return request.resource.data.keys().size() <= 20;
    }

    // ── Visit bookings ───────────────────────────────────────────────────────
    //   Public: CREATE only (submit booking form), validated.
    //   Admin:  full read/write/delete.
    match /bookings/{id} {
      allow create: if validBooking();
      allow read, update, delete: if isAdmin();
    }

    // ── Anonymous visitor profiles ───────────────────────────────────────────
    //   Public: CREATE only (the site never updates an existing visitor doc).
    //   Allowing public UPDATE previously let anyone overwrite ANY visitor
    //   record — removed. Updates/deletes are admin-only now.
    match /visitors/{id} {
      allow create:              if validVisitor();
      allow read, update, delete: if isAdmin();
    }

    // ── Availability settings ────────────────────────────────────────────────
    match /settings/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Published site content ───────────────────────────────────────────────
    match /site_content/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Admin state blobs ────────────────────────────────────────────────────
    //   Most admin_state docs are published site content the public site needs
    //   to read (offices, floors, pricing, site_content, …). BUT `rentals`
    //   holds confidential tenant data (names, manager phones, lease dates), so
    //   it is excluded from public read — admin-only. Firestore rules are OR-ed
    //   across matches, so the exclusion must live inside this single broad rule.
    match /admin_state/{doc} {
      allow read:  if doc != 'rentals' || isAdmin();
      allow write: if isAdmin();
    }

    // ── Current rentals (moved from localStorage) ────────────────────────────
    match /rentals/{doc} {
      allow read, write: if isAdmin();
    }

    // ── Admin audit log ──────────────────────────────────────────────────────
    match /audit_log/{id} {
      allow create, read: if isAdmin();
    }
  }
}
