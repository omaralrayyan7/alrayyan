rules_version = '2';

// ────────────────────────────────────────────────────────────────────────────
// Alrayyan Tower — Firestore Security Rules (Production)
//
// Public (unauthenticated) users can only CREATE specific documents.
// All reads of admin data and ALL writes to sensitive collections require
// Firebase Auth (the admin account: alrayyantower@gmail.com).
// ────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Visit bookings:
    //   - Public can CREATE (submit the booking form).
    //   - Only authenticated admin can read, update, or delete.
    match /bookings/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Cookie acceptance log:
    //   - Public can CREATE (accept cookie banner).
    //   - Only admin can read or delete.
    match /cookie_acceptances/{id} {
      allow create: if true;
      allow read, delete: if request.auth != null;
    }

    // Anonymous visitor profiles:
    //   - Public can CREATE and UPDATE their own profile (keyed by local UUID).
    //   - Only admin can read all or delete.
    match /visitors/{id} {
      allow create, update: if true;
      allow read, delete: if request.auth != null;
    }

    // Availability settings:
    //   - Public site READS (to show available/unavailable units).
    //   - Only admin can write.
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Published site content (business statuses, homepage text, etc.):
    //   - Public site READS.
    //   - Only admin can write.
    match /site_content/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin state (offices, floors, lands, fashion products, arts):
    //   - Public site READS (to render listings).
    //   - Only admin can write.
    match /admin_state/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
